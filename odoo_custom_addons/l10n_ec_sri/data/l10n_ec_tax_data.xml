<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Tax Group: VAT 15% -->
        <record id="tax_group_iva_15" model="account.tax.group">
            <field name="name">IVA 15%</field>
            <field name="country_id" ref="base.ec"/>
        </record>

        <!-- Sales 15% -->
        <record id="tax_sale_15" model="account.tax">
            <field name="name">IVA 15% (Venta)</field>
            <field name="type_tax_use">sale</field>
            <field name="amount_type">percent</field>
            <field name="amount">15.0</field>
            <field name="tax_group_id" ref="tax_group_iva_15"/>
            <field name="description">15%</field>
            <field name="country_id" ref="base.ec"/>
        </record>

        <!-- Purchase 15% -->
        <record id="tax_purchase_15" model="account.tax">
            <field name="name">IVA 15% (Compra)</field>
            <field name="type_tax_use">purchase</field>
            <field name="amount_type">percent</field>
            <field name="amount">15.0</field>
            <field name="tax_group_id" ref="tax_group_iva_15"/>
            <field name="description">15%</field>
            <field name="country_id" ref="base.ec"/>
        </record>
    </data>
</odoo>
