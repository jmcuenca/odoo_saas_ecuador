<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_l10n_ec_vehicle_tree" model="ir.ui.view">
            <field name="name">l10n_ec.vehicle.tree</field>
            <field name="model">l10n_ec.vehicle</field>
            <field name="arch" type="xml">
                <tree string="Vehicles">
                    <field name="name"/>
                    <field name="license_plate"/>
                    <field name="brand"/>
                    <field name="model"/>
                    <field name="active" widget="boolean_toggle"/>
                </tree>
            </field>
        </record>

        <record id="view_l10n_ec_vehicle_form" model="ir.ui.view">
            <field name="name">l10n_ec.vehicle.form</field>
            <field name="model">l10n_ec.vehicle</field>
            <field name="arch" type="xml">
                <form string="Vehicle">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" placeholder="Vehicle Name/ID"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="license_plate"/>
                                <field name="brand"/>
                            </group>
                            <group>
                                <field name="model"/>
                                <field name="active"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_l10n_ec_vehicle" model="ir.actions.act_window">
            <field name="name">Vehicles</field>
            <field name="res_model">l10n_ec.vehicle</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
